#!/usr/bin/env bash
# Sconix Systems — one command. Thin on purpose. Mirrors ~/research/os/bin/sconix.
set -euo pipefail

OS="$HOME/systems/os"
APPS="$HOME/systems/apps"
SYSTEMS="$HOME/systems"
TEMPLATE="$OS/template-web"
APPLIB="$OS/sconixapp"
CORE_DEPLOY="$OS/sconixcore/.venv/bin/sconix-deploy"
CORE_INSPECT="$OS/sconixcore/.venv/bin/sconix-inspect"

usage() {
  cat <<'EOF'
sx — Sconix Systems

  sx new <name> ["one-line pitch"] [--no-gh]
                          scaffold an app in ~/systems/apps/ from template-web
                          (creates a private GitHub repo unless --no-gh)
  sx ls                   list apps + their status
  sx cap  <text...>       drop an idea into ~/systems/inbox.md
  sx ledger <text...>     add a dated note to ~/systems/ledger.md
  sx sync <app>           re-apply template-web (pull in engine/template updates)
  sx gen  <app>           regenerate packages/api-client from the FastAPI OpenAPI spec
  sx secrets <app>        edit apps/<app>/secrets.env (SOPS+age; committed encrypted)
  sx provision user@host  install docker + firewall + /srv + sops/age key on a fresh VPS (run once)
  sx deploy <app> --plan [user@host]
                          create an immutable deployment plan
  sx deploy <app> --approve <plan-id> [user@host]
                          consume approval -> sync -> build -> migrate -> verify
                          (reads apps/<app>/deploy.env: DEPLOY_HOST, APP_DOMAIN)
  sx approve <plan-id> [reason]
                          record one attributable approval for a deployment plan
  sx rollback <app> <release> --plan [user@host]
  sx rollback <app> <release> --approve <plan-id> [user@host]
                          restore a release's code/containers; never reverses DB migrations
  sx canary <app> --plan [user@host]
  sx canary <app> --approve <plan-id> [user@host]
                          isolated stack + route; verify before promotion
  sx promote <app> <canary-plan-id> --plan [user@host]
  sx promote <app> <canary-plan-id> --approve <plan-id> [user@host]
                          switch production traffic to a verified canary
  sx teardown <app> <canary-plan-id> --plan [user@host]
  sx teardown <app> <canary-plan-id> --approve <plan-id> [user@host]
                          remove an isolated canary after it is no longer active
  sx restart <app> [user@host]
                          restart a deployed app's containers in place (no rebuild)
  sx doctor               check the toolchain
EOF
}

slugify() { echo "$1" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-' | sed 's/^-*//;s/-*$//'; }

read_answer() { awk -F'\t' -v k="$2" '$1==k{print $2; exit}' "$1"; }

cmd="${1:-}"; shift || true

case "$cmd" in
  new)
    name="${1:?usage: sx new \"Name\" [\"pitch\"] [--no-gh]}"; shift
    gh=true pitch=""
    for a in "$@"; do
      case "$a" in
        --no-gh) gh=false ;;
        *) pitch="$a" ;;
      esac
    done
    slug="$(slugify "$name")"
    module="$(echo "$slug" | tr '-' '_')"
    dest="$APPS/$slug"
    [ -e "$dest" ] && { echo "already exists: $dest"; exit 1; }
    mkdir -p "$APPS"
    copier copy --trust --defaults \
      --data app_name="$name" \
      --data app_slug="$slug" \
      --data module_name="$module" \
      --data pitch="$pitch" \
      --data sconixapp_path="$APPLIB" \
      --data created_at="$(date -Idate)" \
      "$TEMPLATE" "$dest"
    {
      printf 'app_name\t%s\n' "$name"
      printf 'app_slug\t%s\n' "$slug"
      printf 'module_name\t%s\n' "$module"
      printf 'pitch\t%s\n' "$pitch"
    } > "$dest/.sx-answers"
    git -C "$dest" init -q && git -C "$dest" add -A && git -C "$dest" commit -qm "scaffold $slug" || true
    if [ "$gh" = true ] && command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
      gh repo create "$slug" --private --source "$dest" --remote origin --push \
        && echo "   github: $(gh repo view "$slug" --json url -q .url 2>/dev/null)" \
        || echo "   (skipped GitHub repo — 'gh repo create $slug' failed)"
    fi
    echo
    echo "-> $dest"
    echo "   cd ~/systems/apps/$slug && task setup && task dev"
    ;;

  ls)
    [ -d "$APPS" ] || { echo "no apps yet"; exit 0; }
    for p in "$APPS"/*/; do
      [ -d "$p" ] || continue
      s=$("$CORE_INSPECT" "$p" --json 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin)["manifest"]["lifecycle"]["status"])' \
        2>/dev/null || true)
      printf "  %-28s %s\n" "$(basename "$p")" "${s:-?}"
    done
    ;;

  cap)
    [ $# -gt 0 ] || { echo "nothing to capture"; exit 1; }
    printf -- '- [ ] %s  _(%s)_\n' "$*" "$(date '+%Y-%m-%d %H:%M')" >> "$SYSTEMS/inbox.md"
    echo "captured."
    ;;

  ledger)
    [ $# -gt 0 ] || { echo "nothing to log"; exit 1; }
    printf -- '- **%s** — %s\n' "$(date '+%Y-%m-%d')" "$*" >> "$SYSTEMS/ledger.md"
    echo "logged."
    ;;

  sync)
    proj="${1:?usage: sx sync <app>}"
    dir="$APPS/$proj"
    [ -f "$dir/.sx-answers" ] || { echo "no .sx-answers in $dir"; exit 1; }
    ( cd "$dir" && git diff --quiet && git diff --cached --quiet ) || { echo "commit/stash changes in $proj first"; exit 1; }
    copier copy --trust --overwrite --defaults \
      --data app_name="$(read_answer "$dir/.sx-answers" app_name)" \
      --data app_slug="$proj" \
      --data module_name="$(read_answer "$dir/.sx-answers" module_name)" \
      --data pitch="$(read_answer "$dir/.sx-answers" pitch)" \
      --data sconixapp_path="$APPLIB" \
      --data created_at="$(grep -m1 '^created:' "$dir/app.yaml" 2>/dev/null | awk '{print $2}')" \
      "$TEMPLATE" "$dir"
    echo "synced. review with: git -C $dir diff"
    ;;

  gen)
    proj="${1:?usage: sx gen <app>}"
    dir="$APPS/$proj"
    [ -d "$dir" ] || { echo "no such app: $proj"; exit 1; }
    ( cd "$dir" && pnpm run gen:api )
    ;;

  secrets)
    proj="${1:?usage: sx secrets <app>}"
    dir="$APPS/$proj"
    [ -d "$dir" ] || { echo "no such app: $proj"; exit 1; }
    [ -f "$OS/.age/keys.txt" ] || { echo "no age key at $OS/.age/keys.txt — run: age-keygen -o $OS/.age/keys.txt"; exit 1; }
    f="$dir/secrets.env"
    [ -f "$f" ] || { printf '# apps/%s secrets — SOPS+age encrypted, safe to commit.\nJWT_SECRET=%s\n' \
        "$proj" "$(python3 -c 'import secrets;print(secrets.token_urlsafe(48))')" > "$f"; }
    SOPS_AGE_KEY_FILE="$OS/.age/keys.txt" sops --config "$SYSTEMS/.sops.yaml" "$f"
    ;;

  provision)
    target="${1:?usage: sx provision user@host}"
    echo ":: provisioning $target (docker + firewall + /srv)"
    ssh "$target" 'bash -s' <<'REMOTE'
set -euo pipefail
if ! command -v docker >/dev/null; then
  curl -fsSL https://get.docker.com | sh
fi
sudo systemctl enable --now docker
id -nG "$USER" | grep -qw docker || sudo usermod -aG docker "$USER" || true
sudo mkdir -p /srv && sudo chown "$USER" /srv
if command -v ufw >/dev/null; then
  sudo ufw allow OpenSSH || true
  sudo ufw allow 80/tcp || true
  sudo ufw allow 443/tcp || true
  sudo ufw --force enable || true
fi
docker --version
echo "provisioned OK"
REMOTE
    if [ -f "$OS/.age/keys.txt" ]; then
      echo ":: install sops + push age key to $target"
      ssh "$target" 'command -v sops >/dev/null || { sudo curl -fsSL -o /usr/local/bin/sops https://github.com/getsops/sops/releases/download/v3.13.3/sops-v3.13.3.linux.amd64 && sudo chmod +x /usr/local/bin/sops; }'
      ssh "$target" 'umask 077; mkdir -p ~/.config/sops; cat > ~/.config/sops/age-key.txt' < "$OS/.age/keys.txt"
    fi
    "$0" edge "$target"
    echo ":: done. Re-login on the box once so the docker group applies."
    ;;

  edge)
    # One shared Caddy per box: terminates TLS for every app, routes by domain.
    # Apps join the `sconix_edge` network and drop a site file in /srv/edge/sites/.
    target="${1:?usage: sx edge user@host}"
    echo ":: setting up the shared edge on $target"
    ssh "$target" 'bash -s' <<'REMOTE'
set -euo pipefail
docker network inspect sconix_edge >/dev/null 2>&1 || docker network create sconix_edge
mkdir -p /srv/edge/sites /srv/edge/data /srv/edge/config
cat > /srv/edge/Caddyfile <<'CADDY'
{
	admin 0.0.0.0:2019
}
import /srv/edge/sites/*.caddy
CADDY
[ "$(ls -A /srv/edge/sites 2>/dev/null)" ] || cat > /srv/edge/sites/_placeholder.caddy <<'CADDY'
# apps add <app>.caddy here via `sx deploy`
:9999 {
	respond "edge up"
}
CADDY
cat > /srv/edge/compose.yml <<'YML'
name: sconix-edge
services:
  caddy:
    image: caddy:2-alpine
    container_name: sconix-edge
    restart: unless-stopped
    ports: ["80:80", "443:443"]
    networks: [sconix_edge]
    volumes:
      - /srv/edge/Caddyfile:/etc/caddy/Caddyfile:ro
      - /srv/edge/sites:/srv/edge/sites:ro
      - /srv/edge/data:/data
      - /srv/edge/config:/config
networks:
  sconix_edge:
    external: true
YML
cd /srv/edge && docker compose up -d && docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile 2>/dev/null || true
echo "edge OK"
REMOTE
    ;;

  deploy)
    proj="${1:?usage: sx deploy <app> --plan|--approve <plan-id> [user@host]}"
    shift
    dir="$APPS/$proj"
    [ -d "$dir" ] || { echo "no such app: $proj"; exit 1; }
    # config: apps/<app>/deploy.env  ->  DEPLOY_HOST=user@ip   APP_DOMAIN=trim.sh
    [ -f "$dir/deploy.env" ] && . "$dir/deploy.env"
    mode="${1:-}"
    shift || true
    plan_id=""
    if [ "$mode" = "--approve" ]; then
      plan_id="${1:?usage: sx deploy $proj --approve <plan-id> [user@host]}"
      shift
    elif [ "$mode" != "--plan" ]; then
      echo "deployment requires a plan: sx deploy $proj --plan"
      exit 1
    fi
    host="${1:-${DEPLOY_HOST:-}}"
    [ -n "$host" ] || { echo "no host — pass one or set DEPLOY_HOST in $dir/deploy.env"; exit 1; }
    [ -n "${APP_DOMAIN:-}" ] || { echo "set APP_DOMAIN in $dir/deploy.env"; exit 1; }
    ( cd "$dir" && git diff --quiet && git diff --cached --quiet ) || { echo "commit changes in $proj first"; exit 1; }

    actor="${SCONIX_PRINCIPAL:-${USER:-operator}}"
    if [ "$mode" = "--plan" ]; then
      "$CORE_DEPLOY" plan "$proj" --root "$dir" --host "$host" --domain "$APP_DOMAIN" --by "$actor"
      echo "approve with: sx approve <plan-id> \"reason\""
      exit 0
    fi

    "$CORE_DEPLOY" verify "$plan_id" --root "$dir" --host "$host" --domain "$APP_DOMAIN" >/dev/null
    deploy_failed() {
      "$CORE_DEPLOY" complete "$plan_id" --status failed --evidence "deployment command failed" >/dev/null 2>&1 || true
    }
    trap deploy_failed ERR
    ( cd "$dir" && git push 2>/dev/null || true )

    # sconixapp is a path dep — vendor a clean copy in so the api image can build.
    echo ":: vendor sconixapp -> $proj/_sconixapp"
    rm -rf "$dir/_sconixapp"
    rsync -a --exclude .git --exclude .venv --exclude __pycache__ \
      --exclude '*.egg-info' --exclude .ruff_cache --exclude .pytest_cache \
      "$APPLIB/" "$dir/_sconixapp/"

    # If secrets.env (SOPS-encrypted) exists, it is the source of truth — the plaintext
    # local .env is dev-only and must not ship; the box derives .env by decrypting.
    secrets_rsync=""
    [ -f "$dir/secrets.env" ] && secrets_rsync="--exclude .env"

    release_id="$(git -C "$dir" rev-parse --short=12 HEAD)-$plan_id"
    release_root="/srv/releases/$proj"
    remote_release="$release_root/$release_id"
    echo ":: stage immutable release $release_id"
    ssh "$host" "set -e; umask 077; mkdir -p '$release_root'; test ! -e '$remote_release'; rm -rf '$remote_release.tmp'; mkdir '$remote_release.tmp'"
    rsync -az --delete \
      --exclude .git --exclude node_modules --exclude .venv --exclude .next \
      --exclude __pycache__ --exclude '*.db' --exclude .turbo \
      --exclude docker-compose.override.yml $secrets_rsync \
      "$dir/" "$host:$remote_release.tmp/"
    ssh "$host" "set -e; mv '$remote_release.tmp' '$remote_release'; mkdir -p '/srv/$proj'; rsync -a --delete '$remote_release/' '/srv/$proj/'; printf '%s\n' '$release_id' > '/srv/$proj/.sconix-release'"

    if [ -f "$dir/secrets.env" ]; then
      echo ":: decrypt secrets.env -> .env on $host"
      ssh "$host" "cd /srv/$proj && SOPS_AGE_KEY_FILE=\$HOME/.config/sops/age-key.txt sops -d secrets.env > .env"
    fi

    echo ":: build + up (profile prod) on $host"
    ssh "$host" "cd /srv/$proj && grep -q '^APP_DOMAIN=' .env || echo 'APP_DOMAIN=$APP_DOMAIN' >> .env; docker compose --profile prod build && docker compose --profile prod up -d"

    # Register this app's site with the shared edge Caddy and reload it.
    echo ":: register $APP_DOMAIN with the edge"
    ssh "$host" "set -e
      test -f /srv/$proj/Caddyfile.site || { echo 'no Caddyfile.site — old-style app? redeploy after sx sync'; exit 1; }
      sed -e 's|__DOMAIN__|$APP_DOMAIN|g' -e 's|__API_UPSTREAM__|$proj-api|g' -e 's|__WEB_UPSTREAM__|$proj-web|g' /srv/$proj/Caddyfile.site > /srv/edge/sites/$proj.caddy
      rm -f /srv/edge/sites/_placeholder.caddy
      docker compose -f /srv/edge/compose.yml exec -T caddy caddy reload --config /etc/caddy/Caddyfile"

    echo ":: migrate"
    ssh "$host" "cd /srv/$proj && docker compose exec -T api alembic -c api/alembic.ini upgrade head"

    echo ":: verify health + readiness"
    verified=false
    for attempt in 1 2 3 4 5 6; do
      if curl -fsS --max-time 10 "https://$APP_DOMAIN/healthz" >/dev/null \
        && curl -fsS --max-time 10 "https://$APP_DOMAIN/readyz" >/dev/null; then
        verified=true
        break
      fi
      [ "$attempt" -eq 6 ] || sleep 5
    done
    [ "$verified" = true ] || { echo "verification failed after 6 attempts"; false; }
    "$CORE_DEPLOY" complete "$plan_id" --status verified \
      --evidence "healthz and readyz passed" >/dev/null
    trap - ERR
    printf -- '- **%s** — deploy %s -> %s (%s)\n' "$(date '+%Y-%m-%d %H:%M')" "$proj" "$APP_DOMAIN" "$(git -C "$dir" rev-parse --short HEAD)" >> "$SYSTEMS/ledger.md"
    echo ":: deployed. ledger updated."
    ;;

  approve)
    plan_id="${1:?usage: sx approve <plan-id> [reason]}"
    shift
    reason="${*:-operator approved deployment}"
    actor="${SCONIX_PRINCIPAL:-${USER:-operator}}"
    "$CORE_DEPLOY" approve "$plan_id" --by "$actor" --reason "$reason"
    ;;

  rollback)
    proj="${1:?usage: sx rollback <app> <release> --plan|--approve <plan-id> [user@host]}"
    release="${2:?usage: sx rollback <app> <release> --plan|--approve <plan-id> [user@host]}"
    shift 2
    dir="$APPS/$proj"
    [ -d "$dir" ] || { echo "no such app: $proj"; exit 1; }
    [ -f "$dir/deploy.env" ] && . "$dir/deploy.env"
    mode="${1:-}"; shift || true
    plan_id=""
    if [ "$mode" = "--approve" ]; then plan_id="${1:?plan id required}"; shift
    elif [ "$mode" != "--plan" ]; then echo "rollback requires --plan or --approve"; exit 1
    fi
    host="${1:-${DEPLOY_HOST:-}}"
    [ -n "$host" ] && [ -n "${APP_DOMAIN:-}" ] || { echo "host and APP_DOMAIN required"; exit 1; }
    actor="${SCONIX_PRINCIPAL:-${USER:-operator}}"
    if [ "$mode" = "--plan" ]; then
      "$CORE_DEPLOY" plan "$proj" --root "$dir" --host "$host" --domain "$APP_DOMAIN" \
        --by "$actor" --action rollback --release "$release"
      exit 0
    fi
    "$CORE_DEPLOY" verify "$plan_id" --root "$dir" --host "$host" --domain "$APP_DOMAIN" \
      --action rollback --release "$release" >/dev/null
    rollback_failed() { "$CORE_DEPLOY" complete "$plan_id" --status failed --evidence "rollback failed" >/dev/null 2>&1 || true; }
    trap rollback_failed ERR
    echo ":: restore immutable release $release (database migrations are not reversed)"
    ssh "$host" "set -e; test -d '/srv/releases/$proj/$release'; rsync -a --delete '/srv/releases/$proj/$release/' '/srv/$proj/'; printf '%s\n' '$release' > '/srv/$proj/.sconix-release'; cd '/srv/$proj'; if [ -f secrets.env ]; then SOPS_AGE_KEY_FILE=\$HOME/.config/sops/age-key.txt sops -d secrets.env > .env; fi; docker compose --profile prod build; docker compose --profile prod up -d"
    verified=false
    for attempt in 1 2 3 4 5 6; do
      if curl -fsS --max-time 10 "https://$APP_DOMAIN/healthz" >/dev/null \
        && curl -fsS --max-time 10 "https://$APP_DOMAIN/readyz" >/dev/null; then verified=true; break; fi
      [ "$attempt" -eq 6 ] || sleep 5
    done
    [ "$verified" = true ] || { echo "rollback verification failed"; false; }
    "$CORE_DEPLOY" complete "$plan_id" --status verified --evidence "rollback healthz and readyz passed" >/dev/null
    trap - ERR
    printf -- '- **%s** — rollback %s -> %s\n' "$(date '+%Y-%m-%d %H:%M')" "$proj" "$release" >> "$SYSTEMS/ledger.md"
    echo ":: rollback verified"
    ;;

  canary)
    proj="${1:?usage: sx canary <app> --plan|--approve <plan-id> [user@host]}"
    shift
    dir="$APPS/$proj"
    [ -d "$dir" ] || { echo "no such app: $proj"; exit 1; }
    [ -f "$dir/deploy.env" ] && . "$dir/deploy.env"
    mode="${1:-}"; shift || true
    plan_id=""
    if [ "$mode" = "--approve" ]; then plan_id="${1:?plan id required}"; shift
    elif [ "$mode" != "--plan" ]; then echo "canary requires --plan or --approve"; exit 1
    fi
    host="${1:-${DEPLOY_HOST:-}}"
    [ -n "$host" ] && [ -n "${APP_DOMAIN:-}" ] || { echo "host and APP_DOMAIN required"; exit 1; }
    canary_domain="${CANARY_DOMAIN:-canary.$APP_DOMAIN}"
    actor="${SCONIX_PRINCIPAL:-${USER:-operator}}"
    ( cd "$dir" && git diff --quiet && git diff --cached --quiet ) || { echo "commit changes in $proj first"; exit 1; }
    if [ "$mode" = "--plan" ]; then
      "$CORE_DEPLOY" plan "$proj" --root "$dir" --host "$host" --domain "$canary_domain" \
        --by "$actor" --action canary
      exit 0
    fi
    "$CORE_DEPLOY" verify "$plan_id" --root "$dir" --host "$host" --domain "$canary_domain" \
      --action canary >/dev/null
    slot="$proj-canary-${plan_id:0:8}"
    release_id="$(git -C "$dir" rev-parse --short=12 HEAD)-$plan_id"
    remote_release="/srv/releases/$proj/$release_id"
    canary_failed() {
      ssh "$host" "cd '$remote_release' 2>/dev/null && SCONIX_SLOT='$slot' docker compose -p '$slot' --profile prod down -v || true; rm -f '/srv/edge/sites/$slot.caddy'; docker compose -f /srv/edge/compose.yml exec -T caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null 2>&1 || true" >/dev/null 2>&1 || true
      "$CORE_DEPLOY" complete "$plan_id" --status failed --evidence "canary failed and was torn down" >/dev/null 2>&1 || true
    }
    trap canary_failed ERR
    echo ":: vendor sconixapp -> $proj/_sconixapp"
    rm -rf "$dir/_sconixapp"
    rsync -a --exclude .git --exclude .venv --exclude __pycache__ --exclude '*.egg-info' \
      --exclude .ruff_cache --exclude .pytest_cache "$APPLIB/" "$dir/_sconixapp/"
    secrets_rsync=""; [ -f "$dir/secrets.env" ] && secrets_rsync="--exclude .env"
    ssh "$host" "set -e; umask 077; mkdir -p '/srv/releases/$proj'; test ! -e '$remote_release'; rm -rf '$remote_release.tmp'; mkdir '$remote_release.tmp'"
    rsync -az --delete --exclude .git --exclude node_modules --exclude .venv --exclude .next \
      --exclude __pycache__ --exclude '*.db' --exclude .turbo --exclude docker-compose.override.yml \
      $secrets_rsync "$dir/" "$host:$remote_release.tmp/"
    ssh "$host" "set -e; mv '$remote_release.tmp' '$remote_release'; cd '$remote_release'; if [ -f secrets.env ]; then SOPS_AGE_KEY_FILE=\$HOME/.config/sops/age-key.txt sops -d secrets.env > .env; fi; touch .env; grep -q '^APP_DOMAIN=' .env || echo 'APP_DOMAIN=$canary_domain' >> .env; SCONIX_SLOT='$slot' docker compose -p '$slot' --profile prod build; SCONIX_SLOT='$slot' docker compose -p '$slot' --profile prod up -d; SCONIX_SLOT='$slot' docker compose -p '$slot' exec -T api alembic -c api/alembic.ini upgrade head"
    echo ":: register isolated canary route $canary_domain"
    ssh "$host" "set -e; sed -e 's|__DOMAIN__|$canary_domain|g' -e 's|__API_UPSTREAM__|$slot-api|g' -e 's|__WEB_UPSTREAM__|$slot-web|g' '$remote_release/Caddyfile.site' > '/srv/edge/sites/$slot.caddy'; docker compose -f /srv/edge/compose.yml exec -T caddy caddy reload --config /etc/caddy/Caddyfile"
    echo ":: verify canary through shared edge network"
    ssh "$host" "docker exec sconix-edge wget -qO- 'http://$slot-api:8000/healthz' >/dev/null && docker exec sconix-edge wget -qO- 'http://$slot-api:8000/readyz' >/dev/null"
    "$CORE_DEPLOY" complete "$plan_id" --status verified --evidence "isolated canary healthz and readyz passed at $canary_domain" >/dev/null
    ssh "$host" "printf '%s\\n' '{\"planId\":\"$plan_id\",\"release\":\"$release_id\",\"slot\":\"$slot\",\"domain\":\"$canary_domain\"}' > '/srv/$proj/.sconix-canary-$plan_id.json'"
    trap - ERR
    printf -- '- **%s** — canary %s -> %s (%s)\n' "$(date '+%Y-%m-%d %H:%M')" "$proj" "$canary_domain" "$release_id" >> "$SYSTEMS/ledger.md"
    echo ":: canary verified at https://$canary_domain (slot $slot)"
    ;;

  promote)
    proj="${1:?usage: sx promote <app> <canary-plan-id> --plan|--approve <plan-id> [user@host]}"
    canary_plan_id="${2:?usage: sx promote <app> <canary-plan-id> --plan|--approve <plan-id> [user@host]}"
    shift 2
    dir="$APPS/$proj"
    [ -d "$dir" ] || { echo "no such app: $proj"; exit 1; }
    [ -f "$dir/deploy.env" ] && . "$dir/deploy.env"
    mode="${1:-}"; shift || true
    plan_id=""
    if [ "$mode" = "--approve" ]; then plan_id="${1:?plan id required}"; shift
    elif [ "$mode" != "--plan" ]; then echo "promotion requires --plan or --approve"; exit 1
    fi
    host="${1:-${DEPLOY_HOST:-}}"
    [ -n "$host" ] && [ -n "${APP_DOMAIN:-}" ] || { echo "host and APP_DOMAIN required"; exit 1; }
    actor="${SCONIX_PRINCIPAL:-${USER:-operator}}"
    if [ "$mode" = "--plan" ]; then
      "$CORE_DEPLOY" plan "$proj" --root "$dir" --host "$host" --domain "$APP_DOMAIN" \
        --by "$actor" --action promote --source-plan "$canary_plan_id"
      exit 0
    fi
    "$CORE_DEPLOY" verify "$plan_id" --root "$dir" --host "$host" --domain "$APP_DOMAIN" \
      --action promote --source-plan "$canary_plan_id" >/dev/null
    promote_failed() { "$CORE_DEPLOY" complete "$plan_id" --status failed --evidence "promotion failed" >/dev/null 2>&1 || true; }
    trap promote_failed ERR
    slot="${proj}-canary-${canary_plan_id:0:8}"
    marker="/srv/$proj/.sconix-canary-$canary_plan_id.json"
    echo ":: switch production edge route to verified canary slot $slot"
    ssh "$host" "set -e; test -f '$marker'; grep -q '\"planId\":\"$canary_plan_id\"' '$marker'; grep -q '\"slot\":\"$slot\"' '$marker'; test -f '/srv/$proj/Caddyfile.site'; cp '/srv/edge/sites/$proj.caddy' '/srv/edge/sites/$proj.caddy.pre-promote-$plan_id'; sed -e 's|__DOMAIN__|$APP_DOMAIN|g' -e 's|__API_UPSTREAM__|$slot-api|g' -e 's|__WEB_UPSTREAM__|$slot-web|g' '/srv/$proj/Caddyfile.site' > '/srv/edge/sites/$proj.caddy'; printf '%s\\n' '$canary_plan_id' > '/srv/$proj/.sconix-active-canary'; docker compose -f /srv/edge/compose.yml exec -T caddy caddy reload --config /etc/caddy/Caddyfile"
    verified=false
    for attempt in 1 2 3 4 5 6; do
      if curl -fsS --max-time 10 "https://$APP_DOMAIN/healthz" >/dev/null \
        && curl -fsS --max-time 10 "https://$APP_DOMAIN/readyz" >/dev/null; then verified=true; break; fi
      [ "$attempt" -eq 6 ] || sleep 5
    done
    [ "$verified" = true ] || { echo "promotion verification failed"; false; }
    "$CORE_DEPLOY" complete "$plan_id" --status verified --evidence "production route switched to verified canary and healthz/readyz passed" >/dev/null
    trap - ERR
    printf -- '- **%s** — promote %s canary %s -> %s\n' "$(date '+%Y-%m-%d %H:%M')" "$proj" "$canary_plan_id" "$APP_DOMAIN" >> "$SYSTEMS/ledger.md"
    echo ":: promoted. old route saved for rollback; canary remains running"
    ;;

  teardown)
    proj="${1:?usage: sx teardown <app> <canary-plan-id> --plan|--approve <plan-id> [user@host]}"
    canary_plan_id="${2:?usage: sx teardown <app> <canary-plan-id> --plan|--approve <plan-id> [user@host]}"
    shift 2
    dir="$APPS/$proj"
    [ -d "$dir" ] || { echo "no such app: $proj"; exit 1; }
    [ -f "$dir/deploy.env" ] && . "$dir/deploy.env"
    mode="${1:-}"; shift || true
    plan_id=""
    if [ "$mode" = "--approve" ]; then plan_id="${1:?plan id required}"; shift
    elif [ "$mode" != "--plan" ]; then echo "teardown requires --plan or --approve"; exit 1
    fi
    host="${1:-${DEPLOY_HOST:-}}"
    [ -n "$host" ] && [ -n "${APP_DOMAIN:-}" ] || { echo "host and APP_DOMAIN required"; exit 1; }
    actor="${SCONIX_PRINCIPAL:-${USER:-operator}}"
    if [ "$mode" = "--plan" ]; then
      "$CORE_DEPLOY" plan "$proj" --root "$dir" --host "$host" --domain "$APP_DOMAIN" \
        --by "$actor" --action teardown --source-plan "$canary_plan_id"
      exit 0
    fi
    "$CORE_DEPLOY" verify "$plan_id" --root "$dir" --host "$host" --domain "$APP_DOMAIN" \
      --action teardown --source-plan "$canary_plan_id" >/dev/null
    teardown_failed() { "$CORE_DEPLOY" complete "$plan_id" --status failed --evidence "canary teardown failed" >/dev/null 2>&1 || true; }
    trap teardown_failed ERR
    slot="${proj}-canary-${canary_plan_id:0:8}"
    marker="/srv/$proj/.sconix-canary-$canary_plan_id.json"
    echo ":: tear down isolated canary slot $slot"
    ssh "$host" "set -e; test -f '$marker'; test ! -f '/srv/$proj/.sconix-active-canary' || ! grep -qx '$canary_plan_id' '/srv/$proj/.sconix-active-canary'; cd '/srv/$proj'; SCONIX_SLOT='$slot' docker compose -p '$slot' --profile prod down -v; rm -f '$marker' '/srv/edge/sites/$slot.caddy'; docker compose -f /srv/edge/compose.yml exec -T caddy caddy reload --config /etc/caddy/Caddyfile"
    "$CORE_DEPLOY" complete "$plan_id" --status verified --evidence "isolated canary stack and route removed" >/dev/null
    trap - ERR
    printf -- '- **%s** — teardown %s canary %s\n' "$(date '+%Y-%m-%d %H:%M')" "$proj" "$canary_plan_id" >> "$SYSTEMS/ledger.md"
    echo ":: canary torn down"
    ;;

  restart)
    proj="${1:?usage: sx restart <app> [user@host]}"
    dir="$APPS/$proj"
    [ -d "$dir" ] || { echo "no such app: $proj"; exit 1; }
    [ -f "$dir/deploy.env" ] && . "$dir/deploy.env"
    host="${2:-${DEPLOY_HOST:-}}"
    [ -n "$host" ] || { echo "no host — pass one or set DEPLOY_HOST in $dir/deploy.env"; exit 1; }
    echo ":: restart $proj on $host"
    ssh "$host" "cd /srv/$proj && docker compose --profile prod restart"
    if [ -n "${APP_DOMAIN:-}" ]; then
      sleep 3
      curl -fsS --max-time 10 "https://$APP_DOMAIN/healthz" >/dev/null \
        && echo "   https://$APP_DOMAIN/healthz OK" \
        || echo "   WARN: health check failed after restart"
    fi
    printf -- '- **%s** — restart %s on %s\n' "$(date '+%Y-%m-%d %H:%M')" "$proj" "$host" >> "$SYSTEMS/ledger.md"
    ;;

  doctor)
    echo "Sconix Systems — doctor"
    for t in node pnpm uv copier ruff task gh git sops age docker caddy; do
      printf "  %-9s " "$t"
      if command -v "$t" >/dev/null 2>&1; then
        v="$("$t" --version 2>/dev/null | head -1 || true)"
        echo "${v:-present}"
      else
        echo "MISSING"
      fi
    done
    printf "  %-9s " "dockerd"
    docker info --format '{{.ServerVersion}}' >/dev/null 2>&1 && echo "running" || echo "not reachable"
    printf "  %-9s " "template"
    [ -f "$TEMPLATE/copier.yml" ] && echo "template-web ok" || echo "MISSING $TEMPLATE/copier.yml"
    printf "  %-9s " "applib"
    [ -f "$APPLIB/pyproject.toml" ] && echo "sconixapp ok" || echo "MISSING $APPLIB"
    printf "  %-9s " "core"
    [ -x "$CORE_INSPECT" ] && echo "sconixcore ok" || echo "run: uv sync --project $OS/sconixcore"
    printf "  %-9s " "apps"
    echo "$(find "$APPS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l) scaffolded"
    ;;

  ""|-h|--help|help) usage ;;
  *) echo "unknown: $cmd"; usage; exit 1 ;;
esac
